BOT_TOKEN=<BOT_TOKEN von @BotFather>
CHAT_ID=<deine Telegram-Chat-ID>
# Optional, aber empfohlen: Ping-URL eines healthchecks.io-Checks (Periode 30 Min, Grace 20 Min).
# Der Bot pingt sie nur, wenn ein echter claude -p mit is_error:false durchlaeuft — ein reiner
# Prozess-Ping wuerde einen toten Login nicht bemerken. Bleibt sie leer, laeuft der Bot normal
# weiter, protokolliert das aber als "Capability-Ping UNSCHARF" und sagt es in /status.
HC_URL=
